   "source": [
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "URL = \"https://divar.ir/s/tehran\"\n",
    "page = requests.get(URL)\n",
    "soup = BeautifulSoup(page.content, \"html.parser\")\n",
    "site = soup.find_all('article')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "861b4e64",
   "metadata": {},
   "outputs": [],
   "source": [
    "for q in site:\n",
    "    x=q.find_all(\"div\")\n",
    "    for a in x:\n",
    "        print(a.get_text())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b50b38d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "for q in site:\n",
    "    x=q.find_all(\"div\", class_ = \"kt-post-card__description\")\n",
    "    for a in x:\n",
    "        print(a.get_text())"
   ]
  }
